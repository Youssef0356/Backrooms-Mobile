/* =============================================================================
   BACKROOMS MOBILE - In-game pause menu
   -----------------------------------------------------------------------------
   Same liminal / found footage look as "Menu Style.uss" (fluorescent yellow on
   damp concrete, monospaced terminal type) but built for a full screen overlay
   inside the game level. Lives in a Resources folder so PauseMenuController
   loads it at runtime with Resources.Load<StyleSheet>("Pause menu style").
   ========================================================================== */

.pause-root {
    /* --- palette (matches Menu Style.uss) -------------------------------- */
    --accent: rgb(223, 216, 118);            /* fluorescent yellow */
    --accent-dim: rgb(136, 132, 72);
    --line: rgba(223, 216, 118, 0.20);
    --panel: rgba(9, 10, 5, 0.78);
    --text: rgb(228, 224, 178);
    --muted: rgba(228, 224, 178, 0.50);
    --danger: rgb(196, 92, 74);

    flex-grow: 1;
    color: var(--text);
}

/* the default runtime theme draws a drop shadow under text; drop it here */
.pause-root Label,
.pause-root Button,
.pause-root Slider {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* ============================== pause button (corner) ===================== */

.pause-fab {
    position: absolute;
    top: 18px;
    right: 18px;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    background-color: rgba(9, 10, 5, 0.65);
    background-image: none;
    border-width: 1.5px;
    border-color: var(--line);
    border-radius: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.pause-fab:hover {
    background-color: rgba(223, 216, 118, 0.20);
    border-color: var(--accent);
}

.pause-fab-icon {
    width: 28px;
    height: 28px;
    background-image: resource("Icons/UI_Icon_Settings");
    -unity-background-image-tint-color: var(--accent);
    -unity-background-scale-mode: scale-to-fit;
}

.pause-fab:hover .pause-fab-icon {
    -unity-background-image-tint-color: rgb(255, 252, 200);
}

.flashlight-fab {
    font-size: 18px;
    letter-spacing: 1px;
}

/* ============================== overlay =================================== */

.pause-overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 5, 2, 0.80);
    align-items: center;
    justify-content: center;
}

.pause-overlay.is-hidden {
    display: none;
}

.pause-card {
    width: 680px;
    max-width: 92%;
    max-height: 92%;
    padding-top: 24px;
    padding-bottom: 24px;
    padding-left: 32px;
    padding-right: 32px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    flex-direction: column;
}

.pause-heading {
    font-size: 30px;
    letter-spacing: 10px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
}

.pause-subheading {
    margin-top: 4px;
    margin-bottom: 8px;
    font-size: 12px;
    letter-spacing: 5px;
    color: var(--muted);
    -unity-text-align: middle-center;
}

.pause-divider {
    height: 1px;
    background-color: var(--line);
    margin-top: 14px;
    margin-bottom: 4px;
}

/* ============================== buttons =================================== */

.pause-button {
    margin-top: 16px;
    height: 50px;
    font-size: 20px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: var(--text);
    background-color: rgba(223, 216, 118, 0.05);
    background-image: none;
    border-width: 0;
    border-left-width: 2px;
    border-left-color: rgba(223, 216, 118, 0.30);
    -unity-text-align: middle-left;
    padding-left: 18px;
    transition-property: background-color, color, border-left-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.pause-button:hover,
.pause-button:focus {
    background-color: rgba(223, 216, 118, 0.16);
    border-left-color: var(--accent);
    color: var(--accent);
}

.pause-button--danger {
    color: rgba(228, 224, 178, 0.72);
}

.pause-button--danger:hover,
.pause-button--danger:focus {
    background-color: rgba(196, 92, 74, 0.18);
    border-left-color: var(--danger);
    color: var(--danger);
}

/* ============================== settings rows ============================= */

.pause-setting {
    margin-top: 14px;
}

.pause-setting-row {
    flex-direction: row;
    align-items: center;
}

.pause-setting-label {
    flex-grow: 1;
    font-size: 16px;
    letter-spacing: 4px;
    color: var(--text);
}

.pause-setting-value {
    font-size: 15px;
    letter-spacing: 3px;
    color: var(--accent);
    -unity-text-align: upper-right;
}

.pause-slider {
    width: 100%;
    margin-top: 4px;
}

/* tint the default runtime theme slider to match the palette */
.pause-slider .unity-base-slider__tracker {
    background-color: rgba(223, 216, 118, 0.16);
    height: 4px;
}

.pause-slider .unity-base-slider__dragger {
    width: 14px;
    height: 20px;
    background-color: var(--accent);
    border-width: 0;
}

.pause-slider .unity-base-slider__dragger-border {
    width: 16px;
    height: 22px;
    border-width: 1px;
    border-color: rgba(223, 216, 118, 0.55);
    background-color: rgba(0, 0, 0, 0);
}

/* ============================== mobile-friendly segmented bar ============= */

.pause-segmented-bar {
    flex-direction: row;
    width: 100%;
    margin-top: 8px;
    gap: 6px;
}

.pause-segmented-pill {
    flex-grow: 1;
    flex-basis: 0;
    height: 44px;
    background-color: rgba(223, 216, 118, 0.06);
    background-image: none;
    border-width: 1px;
    border-color: rgba(223, 216, 118, 0.22);
    border-radius: 4px;
    color: var(--muted);
    font-size: 14px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    padding-left: 2px;
    padding-right: 2px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.pause-segmented-pill:hover,
.pause-segmented-pill:focus {
    background-color: rgba(223, 216, 118, 0.16);
    border-color: var(--accent);
    color: var(--text);
}

.pause-segmented-pill.is-pause-pill-active {
    background-color: rgba(223, 216, 118, 0.28);
    border-color: var(--accent);
    border-width: 2px;
    color: var(--accent);
    -unity-font-style: bold;
}

/* ============================== dropdowns (fallback) ====================== */

.pause-dropdown {
    margin-top: 6px;
    width: 100%;
}

.pause-dropdown .unity-base-field__label {
    display: none;
}

.pause-dropdown .unity-base-popup-field__input {
    background-color: rgba(223, 216, 118, 0.06);
    border-width: 0;
    border-left-width: 3px;
    border-left-color: rgba(223, 216, 118, 0.35);
    border-radius: 4px;
    height: 38px;
    padding-left: 12px;
}

.pause-dropdown .unity-base-popup-field__text {
    color: var(--accent);
    font-size: 15px;
    letter-spacing: 2px;
}

/* ============================== controls modal ============================ */

.pause-control-row {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
    height: 32px;
    margin-bottom: 4px;
}

.pause-control-key {
    font-size: 14px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--accent);
}

.pause-control-desc {
    font-size: 13px;
    letter-spacing: 2px;
    color: var(--muted);
}

.is-hidden {
    display: none;
}

/* ============================== survival guide modal ===================== */

.guide-fab {
    position: absolute;
    top: 18px;
    right: 84px;
    width: 56px;
    height: 56px;
    align-items: center;
    justify-content: center;
    background-color: rgba(9, 10, 5, 0.65);
    background-image: none;
    border-width: 1.5px;
    border-color: var(--line);
    border-radius: 8px;
    transition-property: background-color, border-color;
    transition-duration: 0.12s;
}

.guide-fab:hover {
    background-color: rgba(223, 216, 118, 0.20);
    border-color: var(--accent);
}

.guide-fab-text {
    font-size: 26px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-center;
}

.guide-card {
    width: 680px;
    max-width: 94%;
    max-height: 90%;
    padding: 24px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    flex-direction: column;
}

.guide-tabs {
    flex-direction: row;
    margin-top: 14px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-bottom-color: var(--line);
}

.guide-tab-btn {
    flex-grow: 1;
    height: 42px;
    font-size: 13px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--muted);
    background-color: rgba(0, 0, 0, 0);
    border-width: 0;
    border-bottom-width: 2px;
    border-bottom-color: transparent;
    -unity-text-align: middle-center;
    transition-property: color, border-bottom-color, background-color;
    transition-duration: 0.12s;
}

.guide-tab-btn:hover {
    color: var(--text);
    background-color: rgba(223, 216, 118, 0.05);
}

.guide-tab-btn--active {
    color: var(--accent);
    border-bottom-color: var(--accent);
    background-color: rgba(223, 216, 118, 0.10);
}

.guide-scroll {
    flex-grow: 1;
    max-height: 420px;
    padding-right: 6px;
}

.guide-box {
    margin-top: 8px;
    margin-bottom: 8px;
    padding: 12px 14px;
    background-color: rgba(223, 216, 118, 0.05);
    border-left-width: 3px;
    border-left-color: var(--accent);
    border-radius: 4px;
}

.guide-box--danger {
    background-color: rgba(196, 92, 74, 0.10);
    border-left-color: var(--danger);
}

.guide-box-title {
    font-size: 15px;
    letter-spacing: 2px;
    -unity-font-style: bold;
    color: var(--accent);
    margin-bottom: 5px;
}

.guide-box-title--danger {
    color: var(--danger);
}

.guide-box-desc {
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--text);
    white-space: normal;
    -unity-text-align: upper-left;
}

.guide-footer {
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    margin-top: 14px;
    padding-top: 10px;
    border-top-width: 1px;
    border-top-color: var(--line);
}

.guide-toggle {
    font-size: 12px;
    letter-spacing: 2px;
    color: var(--muted);
}

.guide-toggle .unity-toggle__checkmark {
    background-color: rgba(223, 216, 118, 0.12);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 3px;
}
