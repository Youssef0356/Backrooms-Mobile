<?xml version="1.0" encoding="utf-8"?>
<ui:UXML
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xmlns:ui="UnityEngine.UIElements"
    xmlns:uie="UnityEditor.UIElements"
    xsi:noNamespaceSchemaLocation="../../UIElementsSchema/UIElements.xsd"
>
    <Style src="project://database/Assets/_Project/UI/Menu%20Style.uss?fileID=7433441132597879392&amp;guid=76cc536a499db9346bed5c85b3bba50c&amp;type=3#Menu%20Style" />

    <ui:VisualElement name="menu-root" class="menu-root">

        <!-- ============================ screen effects ============================ -->
        <ui:VisualElement name="fx-scrim" class="fx-scrim" picking-mode="Ignore" />
        <ui:VisualElement name="fx-scanlines" class="fx-scanlines" picking-mode="Ignore" />
        <ui:VisualElement name="fx-vignette" class="fx-vignette" picking-mode="Ignore" />

        <!-- ============================ left: title + buttons ============================ -->
        <ui:VisualElement name="left-column" class="left-column">

            <ui:Label name="eyebrow" class="eyebrow" text="SECTOR 0 &#183; HUM 60HZ" />
            <ui:Label name="title" class="title" text="BACKROOMS" />
            <ui:Label name="subtitle" class="subtitle" text="NO EXIT" />
            <ui:VisualElement class="divider" picking-mode="Ignore" />

            <ui:VisualElement name="menu-list" class="menu-list">

                <ui:VisualElement name="menu-item-play" class="menu-item">
                    <ui:Label class="menu-item-marker" text="&gt;" />
                    <ui:Button name="play-button" class="menu-button" text="ENTER" />
                </ui:VisualElement>

                <ui:VisualElement name="menu-item-settings" class="menu-item">
                    <ui:Label class="menu-item-marker" text="&gt;" />
                    <ui:Button name="settings-button" class="menu-button" text="SETTINGS" />
                </ui:VisualElement>

                <ui:VisualElement name="menu-item-controls" class="menu-item">
                    <ui:Label class="menu-item-marker" text="&gt;" />
                    <ui:Button name="controls-button" class="menu-button" text="CONTROLS" />
                </ui:VisualElement>

                <ui:VisualElement name="menu-item-quit" class="menu-item">
                    <ui:Label class="menu-item-marker" text="&gt;" />
                    <ui:Button name="quit-button" class="menu-button menu-button--danger" text="QUIT" />
                </ui:VisualElement>

            </ui:VisualElement>

            <ui:Label name="hint" class="hint" text="TAP A CHOICE OR USE THE ARROW KEYS" />
        </ui:VisualElement>

        <!-- ============================ top right: version ============================ -->
        <ui:VisualElement name="version-block" class="version-block">
            <ui:VisualElement class="version-rule" picking-mode="Ignore" />
            <ui:Label name="version-label" class="version-label" text="v0.0.0" />
            <ui:Label name="build-label" class="build-label" text="BUILD" />
        </ui:VisualElement>

        <!-- ============================ bottom left: hum / rec ============================ -->
        <ui:VisualElement name="status-block" class="status-block">
            <ui:Label name="rec-label" class="rec-label" text="&#9679; REC" />
            <ui:Label name="hum-label" class="hum-label" text="HUMM &#183; HUMM &#183; HUMM" />
        </ui:VisualElement>

        <!-- ============================ settings overlay ============================ -->
        <ui:VisualElement name="settings-panel" class="overlay is-hidden">
            <ui:VisualElement class="overlay-card">
                <ui:Label name="settings-heading" class="overlay-heading" text="SETTINGS" />
                <ui:VisualElement class="divider" picking-mode="Ignore" />

                <ui:ScrollView class="settings-scroll" mode="Vertical" horizontal-scroller-visibility="Hidden">
                    <ui:Slider name="volume-slider" class="setting-slider" label="MASTER VOLUME" low-value="0" high-value="100" value="80" />
                    <ui:Label name="volume-value" class="setting-value" text="80%" />

                    <ui:Slider name="music-slider" class="setting-slider" label="MUSIC VOLUME" low-value="0" high-value="100" value="25" />
                    <ui:Label name="music-value" class="setting-value" text="25%" />

                    <ui:Slider name="sensitivity-slider" class="setting-slider" label="SENSITIVITY" low-value="10" high-value="200" value="100" />
                    <ui:Label name="sensitivity-value" class="setting-value" text="100%" />

                    <ui:Slider name="brightness-slider" class="setting-slider" label="BRIGHTNESS" low-value="0" high-value="100" value="50" />
                    <ui:Label name="brightness-value" class="setting-value" text="50%" />

                    <!-- Mobile-friendly segmented graphics quality selector -->
                    <ui:VisualElement name="graphics-group" class="setting-group">
                        <ui:Label class="setting-group-label" text="GRAPHICS QUALITY" />
                        <ui:VisualElement name="graphics-selector" class="segmented-selector" />
                    </ui:VisualElement>

                    <!-- Mobile-friendly segmented target framerate selector -->
                    <ui:VisualElement name="framerate-group" class="setting-group">
                        <ui:Label class="setting-group-label" text="TARGET FRAMERATE" />
                        <ui:VisualElement name="framerate-selector" class="segmented-selector" />
                    </ui:VisualElement>
                </ui:ScrollView>

                <ui:Button name="settings-close-button" class="overlay-button" text="BACK" />
            </ui:VisualElement>
        </ui:VisualElement>

        <!-- ============================ controls overlay ============================ -->
        <ui:VisualElement name="controls-panel" class="overlay is-hidden">
            <ui:VisualElement class="overlay-card">
                <ui:Label name="controls-heading" class="overlay-heading" text="CONTROLS" />
                <ui:VisualElement class="divider" picking-mode="Ignore" />

                <!-- Tabs: Touch Controls / Keyboard & Mouse -->
                <ui:VisualElement name="controls-tabs" class="controls-tab-bar">
                    <ui:Button name="tab-touch" class="controls-tab-btn" text="TOUCH" />
                    <ui:Button name="tab-keyboard" class="controls-tab-btn is-tab-active" text="KEYBOARD" />
                </ui:VisualElement>

                <!-- Touch Controls Container -->
                <ui:VisualElement name="touch-controls-container" class="controls-container is-hidden">
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="LEFT JOYSTICK" />
                        <ui:Label class="key-desc" text="MOVE" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="RIGHT SCREEN" />
                        <ui:Label class="key-desc" text="DRAG TO LOOK" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="FLASHLIGHT" />
                        <ui:Label class="key-desc" text="TOGGLE LIGHT" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="SPRINT" />
                        <ui:Label class="key-desc" text="HOLD TO RUN" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="TOP RIGHT GEAR" />
                        <ui:Label class="key-desc" text="SETTINGS / PAUSE" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <!-- Keyboard Controls Container -->
                <ui:VisualElement name="keyboard-controls-container" class="controls-container">
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="W A S D" />
                        <ui:Label class="key-desc" text="MOVE" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="MOUSE" />
                        <ui:Label class="key-desc" text="LOOK AROUND" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="F" />
                        <ui:Label class="key-desc" text="FLASHLIGHT" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="SHIFT" />
                        <ui:Label class="key-desc" text="SPRINT" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="SPACE" />
                        <ui:Label class="key-desc" text="JUMP" />
                    </ui:VisualElement>
                    <ui:VisualElement class="key-row">
                        <ui:Label class="key" text="ESC" />
                        <ui:Label class="key-desc" text="SETTINGS / PAUSE" />
                    </ui:VisualElement>
                </ui:VisualElement>

                <ui:Button name="controls-close-button" class="overlay-button" text="BACK" />
            </ui:VisualElement>
        </ui:VisualElement>

    </ui:VisualElement>
</ui:UXML>
