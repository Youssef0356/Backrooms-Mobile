/* =============================================================================
   BACKROOMS MOBILE - Main menu
   -----------------------------------------------------------------------------
   Look: liminal / found footage. Sickly fluorescent yellow on damp concrete,
   CRT scanlines, heavy vignette, monospaced terminal type.
   The menu sits inside the level as a world space panel attached to the camera,
   so every colour is kept translucent to let the backrooms show through.
   ========================================================================== */

.menu-root {
    /* --- palette ------------------------------------------------------- */
    --accent: rgb(223, 216, 118);            /* fluorescent yellow */
    --accent-dim: rgb(136, 132, 72);
    --accent-soft: rgba(223, 216, 118, 0.12);
    --line: rgba(223, 216, 118, 0.20);
    --panel: rgba(9, 10, 5, 0.72);
    --text: rgb(228, 224, 178);
    --muted: rgba(228, 224, 178, 0.50);
    --danger: rgb(196, 92, 74);

    flex-grow: 1;
    position: relative;
    color: var(--text);
    background-color: rgba(5, 6, 3, 0.22);
}

/* ============================== text ============================== */

/* The default runtime theme draws a hard drop shadow under every text. On a
   world space panel the shadow shows up as a second, offset copy of the text,
   so it is switched off here and replaced by the glow on the title. */
.menu-root Label,
.menu-root Button,
.menu-root Slider {
    text-shadow: 0 0 0 rgba(0, 0, 0, 0);
}

/* ============================== screen effects ============================== */

.fx-scrim {
    position: absolute;
    left: -2px;
    top: -2px;
    right: -2px;
    bottom: -2px;
    -unity-background-scale-mode: stretch-to-fill;
    /* left-side scrim baked into a texture: USS has no gradient functions */
    background-image: url("../Art/UI/scrim.png");
}

.fx-scanlines {
    position: absolute;
    left: -2px;
    top: -2px;
    right: -2px;
    bottom: -2px;
    -unity-background-scale-mode: stretch-to-fill;
    /* 1px line / 3px gap scanlines + flat base baked into a texture
       (USS has no repeating-linear-gradient support) */
    background-image: url("../Art/UI/scanlines.png");
}

.fx-vignette {
    position: absolute;
    left: -2px;
    top: -2px;
    right: -2px;
    bottom: -2px;
    -unity-background-scale-mode: stretch-to-fill;
    /* radial edge darkening baked into a texture (USS has no gradient
       functions); the old flat rgba(0,0,0,0.18) base is merged into it */
    background-image: url("../Art/UI/vignette.png");
}

/* ============================== left column ================================ */

.left-column {
    position: absolute;
    left: 80px;
    top: 0;
    bottom: 0;
    width: 680px;
    flex-direction: column;
    justify-content: center;
}

.eyebrow {
    font-size: 18px;
    letter-spacing: 5px;
    color: var(--accent-dim);
    -unity-text-align: middle-left;
    margin-bottom: 6px;
}

.title-logo {
    width: 520px;
    height: 204px;
    background-image: url("../Art/UI/Logo/backrooms_no_exit_title_transparent_cropped.png");
    -unity-background-scale-mode: scale-to-fit;
    margin-bottom: 6px;
}

.title {
    font-size: 72px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-left;
}

/* the only glow in the menu */
.menu-root .title {
    text-shadow: 0 0 22px rgba(223, 216, 118, 0.35);
}

.subtitle {
    font-size: 42px;
    letter-spacing: 12px;
    -unity-font-style: bold;
    color: rgb(225, 58, 48);
    -unity-text-align: middle-left;
    margin-top: 4px;
    text-shadow: 0 0 20px rgba(225, 58, 48, 0.55);
}

.divider {
    height: 2px;
    background-color: var(--line);
    margin-top: 18px;
    margin-bottom: 14px;
}

/* ============================== menu buttons =============================== */

.menu-list {
    flex-direction: column;
    margin-top: 6px;
    margin-bottom: 6px;
}

.menu-item {
    flex-direction: row;
    align-items: center;
    height: 74px;
    margin-bottom: 12px;
}

.menu-item-marker {
    width: 36px;
    font-size: 32px;
    color: rgba(223, 216, 118, 0);
    -unity-text-align: middle-center;
    transition-property: color, translate;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.menu-item:hover .menu-item-marker,
.menu-item.is-active .menu-item-marker {
    color: var(--accent);
    translate: 6px 0;
}

.menu-root .menu-button {
    flex-grow: 1;
    height: 72px;
    padding-left: 26px;
    font-size: 32px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: var(--text);
    background-color: rgba(223, 216, 118, 0.06);
    background-image: none;
    border-width: 0;
    border-left-width: 4px;
    border-left-color: rgba(223, 216, 118, 0.35);
    border-radius: 4px;
    -unity-text-align: middle-left;
    transition-property: background-color, color, translate, border-left-color;
    transition-duration: 0.12s;
    transition-timing-function: ease-out;
}

.menu-root .menu-button:hover {
    background-color: rgba(223, 216, 118, 0.18);
    border-left-color: var(--accent);
    color: var(--accent);
    translate: 8px 0;
}

.menu-root .menu-button:focus {
    background-color: rgba(223, 216, 118, 0.22);
    border-left-color: var(--accent);
    color: var(--accent);
}

.menu-root .menu-button:active {
    background-color: rgba(223, 216, 118, 0.35);
    border-left-color: var(--accent);
    color: rgb(12, 12, 6);
}

.menu-root .menu-button--danger {
    color: rgba(228, 224, 178, 0.72);
}

.menu-root .menu-button--danger:hover {
    background-color: rgba(196, 92, 74, 0.20);
    border-left-color: var(--danger);
    color: var(--danger);
}

.menu-root .menu-button--danger:focus {
    background-color: rgba(196, 92, 74, 0.24);
    border-left-color: var(--danger);
    color: var(--danger);
}

.menu-root .menu-button--danger:active {
    background-color: rgba(196, 92, 74, 0.38);
    border-left-color: var(--danger);
    color: rgb(12, 12, 6);
}

.menu-root .menu-button--highlight {
    color: rgb(210, 245, 180);
    border-left-color: rgb(120, 220, 140);
    background-color: rgba(90, 210, 120, 0.12);
}

.menu-root .menu-button--highlight:hover {
    background-color: rgba(90, 210, 120, 0.25);
    border-left-color: rgb(150, 255, 170);
    color: rgb(180, 255, 190);
}

.menu-root .menu-button--highlight:focus {
    background-color: rgba(90, 210, 120, 0.30);
    border-left-color: rgb(150, 255, 170);
    color: rgb(180, 255, 190);
}

.hint {
    margin-top: 22px;
    font-size: 18px;
    letter-spacing: 4px;
    color: rgba(228, 224, 178, 0.45);
    -unity-text-align: middle-left;
}

/* ============================== version (top right) ========================= */

.version-block {
    position: absolute;
    top: 34px;
    right: 46px;
    flex-direction: column;
    align-items: flex-end;
}

.version-rule {
    width: 190px;
    height: 1px;
    background-color: var(--line);
    margin-bottom: 10px;
}

.version-label {
    font-size: 26px;
    letter-spacing: 4px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: upper-right;
}

.build-label {
    margin-top: 3px;
    font-size: 15px;
    letter-spacing: 4px;
    color: var(--muted);
    -unity-text-align: upper-right;
}

/* ============================== status (bottom left) ======================== */

.status-block {
    position: absolute;
    bottom: 30px;
    left: 64px;
    flex-direction: column;
}

.rec-label {
    font-size: 16px;
    letter-spacing: 5px;
    -unity-font-style: bold;
    color: rgba(196, 92, 74, 0.85);
}

.hum-label {
    margin-top: 4px;
    font-size: 15px;
    letter-spacing: 4px;
    color: rgba(228, 224, 178, 0.40);
}

/* ============================== overlays =================================== */

.overlay {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    background-color: rgba(4, 5, 2, 0.80);
    align-items: center;
    justify-content: center;
}

.overlay.is-hidden {
    display: none;
}

.is-hidden {
    display: none;
}

.overlay-card {
    width: 740px;
    max-width: 92%;
    max-height: 92%;
    padding-top: 28px;
    padding-bottom: 28px;
    padding-left: 36px;
    padding-right: 36px;
    background-color: var(--panel);
    border-left-width: 1px;
    border-right-width: 1px;
    border-top-width: 1px;
    border-bottom-width: 1px;
    border-color: var(--line);
    border-radius: 6px;
    flex-direction: column;
}

.settings-scroll {
    flex-grow: 1;
    max-height: 480px;
    margin-top: 6px;
    margin-bottom: 6px;
}

.overlay-heading {
    font-size: 32px;
    letter-spacing: 8px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-left;
}

.menu-root .overlay-button {
    margin-top: 16px;
    height: 58px;
    font-size: 24px;
    letter-spacing: 6px;
    -unity-font-style: bold;
    color: var(--text);
    background-color: rgba(223, 216, 118, 0.06);
    background-image: none;
    border-width: 0;
    border-left-width: 4px;
    border-left-color: rgba(223, 216, 118, 0.35);
    border-radius: 4px;
    -unity-text-align: middle-left;
    padding-left: 24px;
    transition-property: background-color, color, border-left-color;
    transition-duration: 0.12s;
}

.menu-root .overlay-button:hover,
.menu-root .overlay-button:focus {
    background-color: rgba(223, 216, 118, 0.20);
    border-left-color: var(--accent);
    color: var(--accent);
}

.menu-root .overlay-button:active {
    background-color: rgba(223, 216, 118, 0.35);
    border-left-color: var(--accent);
    color: rgb(12, 12, 6);
}

/* ============================== settings =================================== */

.setting-slider {
    width: 100%;
    margin-top: 14px;
}

.setting-slider .unity-base-field__label {
    font-size: 21px;
    letter-spacing: 3px;
    color: var(--text);
}

.setting-value {
    margin-top: 2px;
    font-size: 20px;
    letter-spacing: 3px;
    color: var(--accent);
    -unity-text-align: upper-right;
}

/* mobile-friendly segmented button selectors */
.setting-group {
    margin-top: 16px;
    width: 100%;
}

.setting-group-label {
    font-size: 21px;
    letter-spacing: 3px;
    color: var(--text);
    margin-bottom: 8px;
}

.segmented-selector {
    flex-direction: row;
    width: 100%;
    gap: 8px;
}

.segmented-pill {
    flex-grow: 1;
    flex-basis: 0;
    height: 48px;
    background-color: rgba(223, 216, 118, 0.06);
    background-image: none;
    border-width: 1px;
    border-color: rgba(223, 216, 118, 0.25);
    border-radius: 4px;
    color: var(--muted);
    font-size: 18px;
    letter-spacing: 2px;
    -unity-text-align: middle-center;
    padding-left: 4px;
    padding-right: 4px;
    transition-property: background-color, border-color, color;
    transition-duration: 0.12s;
}

.segmented-pill:hover,
.segmented-pill:focus {
    background-color: rgba(223, 216, 118, 0.16);
    border-color: var(--accent);
    color: var(--text);
}

.segmented-pill.is-pill-active {
    background-color: rgba(223, 216, 118, 0.28);
    border-color: var(--accent);
    border-width: 2px;
    color: var(--accent);
    -unity-font-style: bold;
}

/* graphics dropdown, styled to match the slider rows */
.setting-dropdown {
    margin-top: 18px;
    width: 100%;
}

.setting-dropdown .unity-base-field__label {
    letter-spacing: 3px;
    font-size: 19px;
    color: var(--text);
}

.setting-dropdown .unity-base-popup-field__input {
    background-color: rgba(223, 216, 118, 0.06);
    border-width: 0;
    border-left-width: 4px;
    border-left-color: rgba(223, 216, 118, 0.35);
    border-radius: 4px;
    height: 48px;
    padding-left: 14px;
}

.setting-dropdown .unity-base-popup-field__text {
    color: var(--accent);
    font-size: 17px;
    letter-spacing: 3px;
}

/* popup list items, in case the default theme popup is light */
.unity-dropdown__item {
    background-color: rgba(4, 5, 2, 0.95);
    color: var(--text);
    letter-spacing: 2px;
    font-size: 17px;
    height: 44px;
}

.unity-dropdown__item:hover,
.unity-dropdown__item--selected {
    background-color: rgba(223, 216, 118, 0.16);
    color: var(--accent);
}

/* tint the default runtime theme slider to match the palette */
.setting-slider .unity-base-slider__tracker {
    background-color: rgba(223, 216, 118, 0.16);
    height: 8px;
}

.setting-slider .unity-base-slider__dragger {
    width: 28px;
    height: 36px;
    background-color: var(--accent);
    border-width: 0;
    border-radius: 4px;
}

.setting-slider .unity-base-slider__dragger-border {
    width: 30px;
    height: 38px;
    border-width: 1px;
    border-color: rgba(223, 216, 118, 0.55);
    background-color: rgba(0, 0, 0, 0);
    border-radius: 4px;
}

/* ============================== controls =================================== */

.key-row {
    flex-direction: row;
    align-items: center;
    margin-top: 14px;
}

.key {
    width: 170px;
    font-size: 20px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--accent);
    -unity-text-align: middle-left;
}

.key-desc {
    flex-grow: 1;
    font-size: 19px;
    letter-spacing: 3px;
    color: var(--muted);
    -unity-text-align: middle-left;
}

/* ============================== controls tabs ============================= */

.controls-tab-bar {
    flex-direction: row;
    margin-top: 10px;
    margin-bottom: 12px;
}

.controls-tab-btn {
    flex-grow: 1;
    height: 48px;
    font-size: 18px;
    letter-spacing: 3px;
    -unity-font-style: bold;
    color: var(--muted);
    background-color: rgba(223, 216, 118, 0.05);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 4px;
    margin-right: 6px;
    transition-property: background-color, color, border-color;
    transition-duration: 0.12s;
}

.controls-tab-btn:hover {
    background-color: rgba(223, 216, 118, 0.14);
    color: var(--text);
}

.controls-tab-btn.is-tab-active {
    background-color: rgba(223, 216, 118, 0.22);
    border-color: var(--accent);
    color: var(--accent);
}

.controls-container {
    flex-direction: column;
}
