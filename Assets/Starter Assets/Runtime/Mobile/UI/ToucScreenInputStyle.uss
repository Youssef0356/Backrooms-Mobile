.touchscreen-button {
    margin: 0;
    padding: 0;
    
    background-color: rgba(0,0,0,0);
    background-image: url("./Images/UI_Circle_Bevel_Base.png#UI_Circle_Bevel_Base");
}

/* Touch Look Zone: full height, covers the right 60% of the screen */
#TouchLookZone {
    position: absolute;
    right: 0;
    top: 0;
    width: 60%;
    height: 100%;
}

#JoystickMove {
    position: absolute;
    width: 330px;
    height: 330px;
    
    left: 25px;
    bottom: 15px;
}

#JoystickBackground {
    flex-grow: 1.0;
    
    background-image: url("./Images/UI_Circle_Faded.png#UI_Circle_Faded");
}

#JoystickHandle {
    width: 130px;
    height: 130px;
    
    position: absolute;

    top: 50%;
    left: 50%;

    translate: -50%;
}

.button-icon {
    position: absolute;
    
    top: 50%;
    left: 50%;
    
    translate: -50%;
    
    width: 65px;
    height: 65px;
}

#JoystickMove #JoystickIcon {
    background-image: url("./Images/UI_Icon_Move.png#UI_Icon_Move");
}

/* Flashlight button: stacked directly above Sprint button */
#ButtonFlashlight {
    width: 110px;
    height: 110px;

    position: absolute;

    right: 40px;
    bottom: 160px;
}

#ButtonFlashlight #ButtonImage {
    background-image: url("./Images/UI_Icon_Flashlight.png#UI_Icon_Flashlight");
}

/* Sprint button: lower right corner */
#ButtonSprint {
    width: 110px;
    height: 110px;

    position: absolute;

    right: 40px;
    bottom: 30px;
}

#ButtonSprint #ButtonImage {
    background-image: url("./Images/UI_Icon_Sprint.png#UI_Icon_Sprint");
}
